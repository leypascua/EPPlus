<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
    <DefineConstants>Core</DefineConstants>
    <NoWarn>CA1416;CS1591</NoWarn>
    <AssemblyVersion>4.5.3.4</AssemblyVersion>
    <FileVersion>4.5.3.4</FileVersion>
    <Version>4.5.3.4</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageProjectUrl>https://github.com/leypascua/EPPlus</PackageProjectUrl>
    <Authors>Jan Källman</Authors>
    <Company></Company>
    <Product>EPPlus</Product>
    <Description>Create advanced Excel spreadsheets using .NET. Forked from https://github.com/JanKallman/EPPlus</Description>
    <AssemblyName>EPPlus</AssemblyName>
    <RootNamespace>EPPlus</RootNamespace>
    <RepositoryUrl></RepositoryUrl>
    <PackageTags>Excel ooxml</PackageTags>
    <Copyright>Jan Källman 2020</Copyright>
    <PackageReleaseNotes>
      # EPPlus 4.5.3.4

      This was forked from [JanKallman/EPPlus](https://github.com/JanKallman/EPPlus). Primary purpose: Allow EPPlus 4.5.3 to be used in modern 
      cross-platform .NET

      Due to Microsoft abandoning Linux support for System.Drawing.Common, this version is only supported to run in Windows.
</PackageReleaseNotes>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>OpenOfficeXml.snk</AssemblyOriginatorKeyFile>
    <NeutralLanguage />
    <PackageLicenseFile>lgpl-3.0.txt</PackageLicenseFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='AnyCPU'">
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\EPPlus.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Packaging\DotNetZip\ZipFile.SaveSelfExtractor.cs" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
	  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Update="readme.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="lgpl-3.0.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
</Project>
